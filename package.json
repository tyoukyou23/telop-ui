{
  "name": "telop-ui",
  "version": "0.1.0",
  "description": "Japanese TV-broadcast style React UI kit for projectors, signage and live presentations — telops, lower thirds, big numbers, rankings and wipes.",
  "license": "MIT",
  "author": "tyoukyou23",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyoukyou23/telop-ui.git"
  },
  "homepage": "https://github.com/tyoukyou23/telop-ui#readme",
  "keywords": [
    "react",
    "ui",
    "broadcast",
    "telop",
    "signage",
    "presentation",
    "live",
    "projector",
    "japanese",
    "tv"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/write-css.mjs",
    "prepare": "npm run build",
    "dev": "vite demo",
    "demo:build": "vite build demo --outDir ../demo-dist --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}
